# 默认按文本处理，仓库内统一用 LF
* text=auto eol=lf

# 二进制文件不要做行尾转换，否则会损坏
*.jar   binary
*.png   binary
*.jpg   binary
*.ogg   binary
*.bbmodel binary

# Windows 批处理必须保持 CRLF，否则解析会出错
*.bat  text eol=crlf
gradlew.bat text eol=crlf

# shell 脚本必须保持 LF，否则在 Linux/CI 上无法执行
gradlew  text eol=lf
*.sh     text eol=lf

# Large authored model sources and generated geometry are versioned through Git LFS.
*.bbmodel filter=lfs diff=lfs merge=lfs -text
*.geo.json filter=lfs diff=lfs merge=lfs -text
